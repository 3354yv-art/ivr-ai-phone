# מפתח חינמי מ-https://aistudio.google.com/apikey
GEMINI_API_KEY=
# מספר מערכת ימות:סיסמה (לדוגמה 0771234567:123456) - לשליפת ההקלטות
YEMOT_TOKEN=
# מילה סודית שנכנסת לכתובת השלוחה. כל מחרוזת ארוכה
IVR_KEY=
# מספרי הטלפון שמותר להם להתקשר (מופרדים בפסיק). ריק = כולם
ALLOWED_PHONES=05XXXXXXXX
# למייל (אופציונלי): ג'ימייל + סיסמת אפליקציה
MAIL_USER=
MAIL_APP_PASSWORD=
PORT=3000
# כתובת https ציבורית של השרת (נכנסת לקישור במייל)
BASE_URL=
# חיבור ג'ימייל למשתמשים (Google Cloud, OAuth Client מסוג Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# אופציונלי: שרת SMTP אחר לשליחת מיילי הקישור (ברירת מחדל: ג'ימייל של MAIL_USER)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
DATA_DIR=./data
